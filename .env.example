TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# Optional: write per-decision JSONL traces here.
# TRACE_DIR=artifacts/traces
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Optional: a dedicated automation Chrome started with --remote-debugging-port=9222 --user-data-dir=<its own dir>;
# Browser Harness only finds standard profile folders by itself.
# BU_CDP_URL=http://127.0.0.1:9222
# Optional: open the owned target in its own window (recommended for a dedicated automation profile).
# JEV_OWN_WINDOW=1
# Optional: viewport width in CSS px (default 1480; height is 780).
# JEV_VIEWPORT_WIDTH=1480
